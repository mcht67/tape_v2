########################################
##       Project configuration       ##
########################################

# Name of the project
PROJECT_NAME=train-bird-models

########################################
##      Docker configuration         ##
########################################

# Docker Hub username for pushing/pulling Docker images
#DOCKERHUB_USERNAME=mcht67

# Python version for the Docker image -> Handled in Dockerfile
# PYTHON_VERSION=3.10.18

########################################
##   TensorBoard Host configuration   ##
########################################

# # SSH Host for TensorBoard 
# TUSTU_TENSORBOARD_HOST=marckh

# # Interval in epochs for syncing TensorBoard logs to Host
# SYNC_INTERVAL=1

# # Path to the directory where TensorBoard logs are stored
# TENSORBOARD_HOST_DIR=ml-projects

########################################
##     HPC Cluster configuration      ##
########################################

# # SSH config for the HPC Cluster
# HPC_SSH=hpc

# # Path to the directory where the Git repository is cloned on the HPC Cluster
# HPC_DIR=/scratch/cohrt

########################################
##     Venvs and python paths  ##
########################################

# Local venv directories
# LOCAL_BASE_VENV=/venv
# LOCAL_PERCH_VENV=/perch-venv
# LOCAL_TRAIN_VENV=/train-venv
LOCAL_COMPLETE_VENV=/complete-venv

# Local Python binaries 
# LOCAL_BASE_PYTHON=${LOCAL_BASE_VENV}/bin/python
# LOCAL_PERCH_PYTHON=${LOCAL_PERCH_VENV}/bin/python
# LOCAL_TRAIN_PYTHON=${LOCAL_TRAIN_VENV}/bin/python
LOCAL_COMPLETE_PYTHON=${LOCAL_COMPLETE_VENV}/bin/python

# Docker venv directories
DOCKER_COMPLETE_VENV=/opt/complete-venv

# Docker Python binaries
DOCKER_COMPLETE_PYTHON=${DOCKER_COMPLETE_VENV}/bin/python

###################################################
##     HPC Hugging Face cache configuration      ##
###################################################
HF_HOME=/beegfs/scratch/cohrt/.cache/huggingface
HF_HUB_CACHE=/beegfs/scratch/cohrt/.cache/huggingface/hub
HF_DATASETS_CACHE=/beegfs/scratch/cohrt/.cache/huggingface/datasets