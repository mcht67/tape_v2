{
  "version": "0.2.0",
  "configurations": [

      {
      "name": "Python: perch_embed",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/perch_embed_audio_stream.py",
      "console": "integratedTerminal",
      "args": [
        "--huggingface_path", "mcht67/PolyBirdMix",
        "--dataset_config", "polyphonic",
        "--subset", "HSN",
        "--input_features", "[\"audio\"]",
        "--embeddings", "[\"perch_v2_cpu\"]",
        "--force_recompute"
      ]
    },
    

    {
      "name": "Python: make_result_tables",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/scripts/make_result_tables.py",
      "console": "integratedTerminal",
      "args": [
        "--target_dir", "archive/Pooled-Embeddings",
        "--out", "results/pooled_embeddings.tex"
      ]
    },

    {
    "name": "Python: birdset_embed",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/source/birdset_embed_audio_stream.py",
    "console": "integratedTerminal",
    "args": [
      "--huggingface_path", "mcht67/PolyBirdMix",
      "--dataset_config", "polyphonic",
      "--subset", "UHH",
      "--input_features", "[\"audio\"]",
      "--embeddings", "[\"Bird-MAE-huge\"]",
      "--force_recompute"
    ] 
    },

    {
      "name": "Python: Launch with subprocess debugging",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "subProcess": true
    },
 

  ]
}